# Base de données PostgreSQL
DATABASE_URL="postgresql://djassa:djassa_pass@localhost:5432/djassa_db?schema=public"

# JWT
JWT_SECRET="djassa_secret_min_32_chars_changez_en_production"
JWT_EXPIRES_IN="8h"

# Application
PORT=3001
NODE_ENV=development

# CORS (URL du frontend)
CORS_ORIGIN="http://localhost:3000"

# Paiement (à remplir avec les vraies clés du fournisseur)
PAYMENT_PROVIDER_SECRET=""
PAYMENT_WEBHOOK_SECRET=""

# Commission par défaut (ex: 0.05 = 5%)
DEFAULT_COMMISSION_RATE=0.05

# Délai d'expiration des réservations (en minutes)
RESERVATION_EXPIRY_MINUTES=30
